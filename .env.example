# Export these values in your shell; the Python entrypoints do not load this file.
OPENAI_API_KEY=
# Optional compatible API endpoint for the Cognitive System.
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=echo
PROACT_COGNITIVE_MODEL=gpt-4.1-mini-2025-04-14
# Optional scenario override; defaults to Appendix D's integrated scenario
# in src/prompts/scenario.txt for both Realtime and cognition.
# PROACT_SCENARIO="Your interaction scenario."
PROACT_SERVER_URL=http://localhost:32558
MOTION_CLIP_MODEL=openai/clip-vit-base-patch32
# Use absolute paths obtained from your own checkout (see README).
MOTION_CHECKPOINT="$PWD/checkpoints/ProAct/checkpoints/controlnet_model_800.pt"
MOTION_BASE_CHECKPOINT="$PWD/checkpoints/ProAct/checkpoints/audio_backbone_model_600.pt"
MOTION_CONTROLNET_DATA_ROOT="$PWD/data/ProAct-Data/processed_seg"
MOTION_AUDIO_DATA_ROOT="$PWD/src/assets/preprocessing/audio"
MOTION_BACKBONE_DATA_ROOT="$PWD/data/processed/audio/feat_30fps_5s_WithExp_MFCC_WithStd"
# Retargeted raw motion/audio and annotation inputs for preprocessing.
MOTION_RAW_DATA_ROOT="$PWD/data/raw/photoreal_g1"
MOTION_SEG_RAW_ROOT="$PWD/data/raw/seg_g1"
MOTION_AUDIO_PROCESSED_DIR="$PWD/data/processed/audio"
MOTION_SEG_PROCESSED_DIR="$PWD/data/processed/seg"
PROACT_DATA_PIPE="$MOTION_AUDIO_DATA_ROOT/data_pipe_30fps.sav"
PROACT_OUTPUT_SCALER="$MOTION_AUDIO_DATA_ROOT/output_scaler.sav"
PROACT_TEXT_DATA_PIPE="$MOTION_CONTROLNET_DATA_ROOT/data_pipe_30fps.sav"
PROACT_TEXT_OUTPUT_SCALER="$MOTION_CONTROLNET_DATA_ROOT/output_scaler.sav"
# Sherpa-ONNX model directory, downloaded separately.
SHERPA_MODEL_DIR="$PWD/data/asr/sherpa-onnx-zipformer-zh-en-2023-11-22"
